# Copy to backend/.env (git-ignored) and edit. Real environment variables override this file.

# Extra browser origins allowed to use the backend (REST and the PPG signal websockets), comma separated.
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed. Add one laptop address only if needed, e.g.
#   COPILOT_ALLOWED_ORIGINS=http://192.168.1.20:5173
# Restart the backend after editing (the REST allow-list is read at start-up).
# The backend must also listen on that address (uvicorn --host 0.0.0.0, or run_backend.py with its host changed),
# the frontend must run with `npm run dev -- --host`, and VITE_API_URL must point at the backend's address.
COPILOT_ALLOWED_ORIGINS=
